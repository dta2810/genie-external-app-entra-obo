# Copy to infra/config.local.env (gitignored) and fill in. Every deploy value lives here.

# Azure
AZ_SUBSCRIPTION=<subscription-id>
AZ_TENANT_ID=<entra-tenant-id>            # must be the SAME tenant as the Databricks workspace (Pattern 1)
AZ_LOCATION=eastus2
AZ_RESOURCE_GROUP=rg-genie-obo-demo
AZ_TAGS="owner=<you@company.com> purpose=genie-external-obo-demo"

# Container Apps
ACA_ENVIRONMENT=cae-genie-obo
ACA_APP_NAME=ca-genie-obo
ACR_NAME=<globally-unique-acr-name>
IMAGE_TAG=v1
ACA_CPU=0.5
ACA_MEMORY=1.0Gi
# 1 replica on purpose: MSAL token cache is in-process (phase 2 = shared cache)
ACA_MIN_REPLICAS=1
ACA_MAX_REPLICAS=1

# Entra app registration (created if ENTRA_APP_ID is empty)
ENTRA_APP_NAME=genie-obo-demo
ENTRA_APP_ID=
# Users allowed to sign in (Assignment required). Space-separated UPNs / emails.
ENTRA_ASSIGNED_USERS="<you@company.com>"

# Demo only: shows the 'Simulate token expiry' button and /api/debug/expire
ENABLE_DEBUG=false

# Databricks
DATABRICKS_HOST=https://adb-<workspace-id>.<n>.azuredatabricks.net
GENIE_SPACE_ID=<genie-space-id>
