# Local run only (copy to .env, gitignored). In Azure these come from Container App env vars/secrets.
AZURE_TENANT_ID=<entra-tenant-id>
AZURE_CLIENT_ID=<app-registration-client-id>
AZURE_CLIENT_SECRET=<client-secret>
# Must be registered as a redirect URI on the app registration
REDIRECT_URI=http://localhost:8000/auth/callback
DATABRICKS_HOST=https://adb-<workspace-id>.<n>.azuredatabricks.net
GENIE_SPACE_ID=<genie-space-id>
# openssl rand -hex 32
SESSION_SECRET=<random-hex>
HTTPS_ONLY=false
REQUIRE_EASY_AUTH=false
